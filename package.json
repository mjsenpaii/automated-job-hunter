{
  "name": "job-application-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI job discovery and application assistant",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "discovery:arbeitnow": "pnpm --filter @job-app/ingestion build && pnpm --filter @job-app/ingestion discovery:arbeitnow",
    "discovery:remotive": "pnpm --filter @job-app/ingestion build && pnpm --filter @job-app/ingestion discovery:remotive",
    "discovery:lever": "pnpm --filter @job-app/ingestion build && pnpm --filter @job-app/ingestion discovery:lever",
    "discovery:profile-audit": "pnpm --filter @job-app/ingestion build && pnpm --filter @job-app/ingestion discovery:profile-audit",
    "reprocess-job-extractions": "pnpm --filter @job-app/ingestion build && pnpm --filter @job-app/ingestion reprocess-job-extractions",
    "trigger:dev": "pnpm build && npx trigger.dev@4.5.7 dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@job-app/ingestion": "workspace:*",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.7",
    "@trigger.dev/sdk": "4.5.7",
    "import-in-the-middle": "3.0.1",
    "trigger.dev": "4.5.7",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
