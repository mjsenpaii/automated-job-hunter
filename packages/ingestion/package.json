{
  "name": "@job-app/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./import-contracts": {
      "types": "./dist/import-contracts.d.ts",
      "default": "./dist/import-contracts.js"
    },
    "./gemini-contracts": {
      "types": "./dist/gemini-contracts.d.ts",
      "default": "./dist/gemini-contracts.js"
    },
    "./government-enrichment": {
      "types": "./dist/government-enrichment.d.ts",
      "default": "./dist/government-enrichment.js"
    },
    "./discovery": {
      "types": "./dist/discovery/contracts.d.ts",
      "default": "./dist/discovery/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "backfill:government": "node dist/backfill-government-metadata.js",
    "discovery:arbeitnow": "node dist/discovery/arbeitnow-cli.js",
    "discovery:remotive": "node dist/discovery/remotive-cli.js",
    "discovery:lever": "node dist/discovery/lever-cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@job-app/classification": "workspace:*",
    "@job-app/core": "workspace:*",
    "@job-app/db": "workspace:*",
    "@job-app/scoring": "workspace:*",
    "cheerio": "^1.2.0",
    "nanoid": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
